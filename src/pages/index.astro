---
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CityGrid from '../components/CityGrid.astro';
import Faq from '../components/Faq.astro';
import JsonLd from '../components/JsonLd.astro';
import LastReviewed from '../components/LastReviewed.astro';
import phonesData from '../data/phones.json';
import servicesData from '../data/services.json';
import subservicesData from '../data/subservices.json';
import costsData from '../data/costs.json';
import problemGuides from '../data/guides.json';
import faqsData from '../data/faqs.json';

const homeFaqs = faqsData.slice(0, 4);
---

<Base
  title="Michigan Water Damage Referral Network | 24/7 Local Contractor Connection"
  description="Connect 24/7 with independent Michigan water damage restoration and emergency plumbing professionals across Detroit, Grand Rapids, Lansing, and statewide."
  pageType="home"
>
  <JsonLd
    type="website"
    title="Michigan Water Damage Referral Network"
    description="Connect 24/7 with independent Michigan water damage restoration and emergency plumbing professionals across Detroit, Grand Rapids, Lansing, and statewide."
    faqs={homeFaqs}
  />

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block rounded-full bg-amber-500/20 px-4 py-1.5 text-xs sm:text-sm font-bold text-amber-300 border border-amber-500/30 uppercase tracking-wider mb-4">
        Michigan Statewide Emergency Referral Network
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight max-w-4xl mx-auto leading-tight">
        24/7 Emergency Connection to Independent Michigan Contractors
      </h1>
      <p class="mt-6 text-base sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Facing basement flooding, a burst pipe, sewage backup, or a plumbing emergency? Our direct referral line connects you 24/7 with independent, licensed local specialists.
      </p>

      <!-- Two Primary Hero Call Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-2xl mx-auto">
        <!-- Restoration Button -->
        <div class="w-full sm:w-1/2">
          <a
            href={`tel:${phonesData.restoration.tel}`}
            class="flex flex-col items-center justify-center rounded-xl bg-amber-600 px-6 py-4 text-white shadow-lg hover:bg-amber-700 transition-all font-bold text-base active:scale-95"
            data-ga-event="tel-click"
            data-phone-line={phonesData.restoration.display}
            data-service="restoration"
          >
            <span class="text-xs uppercase tracking-wider text-amber-200">Restoration & Cleanup</span>
            <span class="text-lg">Call {phonesData.restoration.display}</span>
          </a>
          <p class="text-[11px] text-slate-400 mt-1">Water · Mold · Fire · Sewage (24/7)</p>
        </div>

        <!-- Plumbing Button -->
        <div class="w-full sm:w-1/2">
          <a
            href={`tel:${phonesData.plumbing.tel}`}
            class="flex flex-col items-center justify-center rounded-xl bg-sky-600 px-6 py-4 text-white shadow-lg hover:bg-sky-700 transition-all font-bold text-base active:scale-95"
            data-ga-event="tel-click"
            data-phone-line={phonesData.plumbing.display}
            data-service="plumbing"
          >
            <span class="text-xs uppercase tracking-wider text-sky-200">Plumbing & Leaks</span>
            <span class="text-lg">Call {phonesData.plumbing.display}</span>
          </a>
          <p class="text-[11px] text-slate-400 mt-1">Leaks · Drains · Pipes · Sump Pumps (24/7)</p>
        </div>
      </div>

      <div class="mt-8 max-w-md mx-auto text-xs text-slate-400">
        <p>• 24/7 phone connection • Independent local contractors • Direct pricing discussions</p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-16">
    <!-- Pick Your Problem Section: All 5 Services and 28 Sub-Services -->
    <section aria-labelledby="problem-tiles-heading">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 id="problem-tiles-heading" class="text-3xl font-extrabold tracking-tight text-slate-900">
          Select Your Property Damage Emergency
        </h2>
        <p class="mt-3 text-base text-slate-600">
          Choose your situation to view Michigan-specific guidelines, verified repair cost benchmarks, and dedicated 24/7 phone lines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map(service => {
          const phone = service.phone_vertical === 'plumbing' ? phonesData.plumbing : phonesData.restoration;
          const subs = subservicesData.filter(s => s.service === service.slug);
          return (
            <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:border-amber-500 hover:shadow-md transition-all">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-amber-700">24/7 Emergency Line</span>
                <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">
                  <a href={`/${service.slug}/`} class="hover:text-amber-600">
                    {service.name}
                  </a>
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  {service.description}
                </p>

                <!-- Sub-services linked directly from tile -->
                <div class="my-4 pt-3 border-t border-slate-100">
                  <span class="block text-xs font-bold uppercase text-slate-400 mb-2">Sub-Services Covered</span>
                  <ul class="space-y-1 text-xs text-slate-600">
                    {subs.map(sub => (
                      <li>
                        <a href={`/${service.slug}/${sub.slug}/`} class="hover:text-amber-700 hover:underline">
                          • {sub.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
                <a
                  href={`tel:${phone.tel}`}
                  class="flex items-center justify-center gap-2 rounded-xl bg-amber-600 py-3 text-sm font-bold text-white hover:bg-amber-700 transition-colors"
                  data-ga-event="tel-click"
                  data-phone-line={phone.display}
                  data-service={service.slug}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                    <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1c-9.39 0-17-7.61-17-17a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.2 2.2z"/>
                  </svg>
                  <span>Call {phone.display}</span>
                </a>
                <a href={`/${service.slug}/`} class="text-center text-xs font-semibold text-slate-600 hover:text-amber-700 py-1">
                  Read Full Service Guide →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- How the Referral Network Works -->
    <section class="rounded-2xl bg-slate-50 border border-slate-200 p-8 sm:p-12">
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
          How Our Michigan Referral Network Works
        </h2>
        <p class="text-base text-slate-700 leading-relaxed mb-4">
          Michigan Water Damage Referral Network is an independent directory and phone routing service. We do not dispatch company-owned trucks or perform hands-on contractor labor.
        </p>
        <p class="text-base text-slate-700 leading-relaxed mb-4">
          When you call our telephone numbers, your call is connected to an independent local contractor who services your Michigan community. You speak directly with the contractor to confirm their pricing, schedule, licensing, and insurance before dispatching.
        </p>
        <div class="mt-6">
          <a href="/how-it-works/" class="text-sm font-bold text-amber-700 hover:text-amber-800 underline">
            Read our complete operational overview and contractor standards →
          </a>
        </div>
      </div>
    </section>

    <!-- Michigan Cost Guides Section (All 6 linked) -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Michigan Property Damage & Plumbing Cost Guides
          </h2>
          <p class="text-sm text-slate-600 mt-1">Verified regional pricing benchmarks with cited public industry data.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {costsData.map(cost => (
          <a
            href={`/cost/${cost.topic}/`}
            class="rounded-xl border border-slate-200 bg-white p-5 hover:border-amber-500 hover:shadow-md transition-all flex flex-col justify-between"
          >
            <div>
              <h3 class="text-base font-bold text-slate-900 mb-2">{cost.name}</h3>
              <p class="text-xs text-slate-500 mb-3">Typical range: ${cost.low.toLocaleString()} – ${cost.high.toLocaleString()} {cost.unit}</p>
            </div>
            <span class="text-xs font-semibold text-amber-700">View Cost Factors & Insurance Notes →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Emergency Problem Guides Section (All 6 linked) -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Emergency Homeowner Problem Guides
          </h2>
          <p class="text-sm text-slate-600 mt-1">First-hour action checklists and diagnostics for active Michigan property emergencies.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {problemGuides.map(guide => (
          <a
            href={`/guides/${guide.topic}/`}
            class="rounded-xl border border-slate-200 bg-white p-5 hover:border-amber-500 hover:shadow-md transition-all flex flex-col justify-between"
          >
            <div>
              <h3 class="text-base font-bold text-slate-900 mb-2">{guide.title}</h3>
              <p class="text-xs text-slate-600 line-clamp-2 mb-3">{guide.metaDescription}</p>
            </div>
            <span class="text-xs font-semibold text-amber-700">Read Step-by-Step Guide →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Michigan Seasonal Weather Risks -->
    <section>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-6">
        Michigan Seasonal Property Risks & Water Hazards
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-slate-900 mb-2">Winter Freeze & Burst Pipes</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Prolonged polar vortex events and sub-zero temperatures regularly freeze exterior-wall supply lines, unheated crawlspaces, and vintage plumbing across Michigan.
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-slate-900 mb-2">Spring Snowmelt & Sump Overload</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Rapid spring thaws combined with heavy rains elevate the water table, driving massive hydrostatic pressure against older Michigan basements and taxing mechanical sump systems.
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-slate-900 mb-2">Summer Cloudbursts & Sewer Backups</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Severe convective summer thunderstorms frequently exceed combined sewer capacities in mature urban areas, pushing contaminated runoff into residential drains.
          </p>
        </div>
      </div>
    </section>

    <!-- City Hubs -->
    <CityGrid title="Michigan Regional Hubs & Local Coverage" />

    <!-- Services Overview -->
    <section>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">
        Full Property Restoration & Plumbing Service Silos
      </h2>
      <p class="text-sm text-slate-600 mb-6">Comprehensive guides and independent contractor routing across every major property restoration category.</p>
      <ServiceGrid />
    </section>

    <!-- FAQs -->
    <Faq items={homeFaqs} title="Frequently Asked Questions About Our Referral Line" />

    <!-- Section 9 Full Disclosure -->
    <div class="my-8">
      <Disclosure variant="full" />
    </div>

    <LastReviewed />
  </div>
</Base>
