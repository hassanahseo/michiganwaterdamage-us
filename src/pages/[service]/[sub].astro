---
import ServicePage from '../../layouts/ServicePage.astro';
import servicesData from '../../data/services.json';
import subservicesData from '../../data/subservices.json';
import citiesData from '../../data/cities.json';
import faqsData from '../../data/faqs.json';
import CallButton from '../../components/CallButton.astro';

export async function getStaticPaths() {
  return subservicesData.map((sub) => {
    const service = servicesData.find((s) => s.slug === sub.service)!;
    const siblingSubs = subservicesData.filter((s) => s.service === sub.service && s.slug !== sub.slug);
    const faqs = faqsData.filter((f) => f.category === sub.service || f.category === 'general');
    return {
      params: { service: sub.service, sub: sub.slug },
      props: { service, subservice: sub, siblingSubs, faqs },
    };
  });
}

const { service, subservice, siblingSubs, faqs } = Astro.props;

// Dynamically load MDX content if available
const mdxModules = import.meta.glob('/src/content/subservices/*.mdx', { eager: true }) as Record<string, any>;
const mdxPath = `/src/content/subservices/${service.slug}--${subservice.slug}.mdx`;
const BodyContent = mdxModules[mdxPath]?.default;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: service.name, url: `/${service.slug}/` },
  { name: subservice.name, url: `/${service.slug}/${subservice.slug}/` },
];
---

<ServicePage
  title={`${subservice.name} in Michigan | 24/7 Local Referral`}
  metaDescription={`Emergency ${subservice.name.toLowerCase()} referral across Michigan. 24/7 direct phone connection to independent local specialists.`}
  h1={`${subservice.name} in Michigan`}
  service={service.slug}
  serviceName={subservice.name}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  pageType="subservice-statewide"
  showFaqComponent={!BodyContent}
  showCityGridComponent={!BodyContent}
>
  {BodyContent ? (
    <BodyContent />
  ) : (
    <>
      <h2>Direct Answer & Emergency Guidance</h2>
      <p>
        When dealing with {subservice.name.toLowerCase()} in Michigan, prompt intervention is critical to limit property loss and avoid hazardous microbial contamination. Michigan Water Damage Referral Network connects you 24/7 with independent, licensed local contractors equipped for rapid remediation.
      </p>
      <p>
        Call our dedicated phone routing line to speak directly with an independent local contractor who can assess your situation and coordinate on-site emergency service.
      </p>

      <h2>Common Causes of {subservice.name} in Michigan Homes</h2>
      <p>
        Michigan properties face intense climate variations ranging from heavy Great Lakes lake-effect snow and rapid spring thaws to torrential summer downpours. These environmental pressures frequently overwhelm aging residential drainage systems, sump pumps, and structural plumbing pipes.
      </p>
      <ul>
        <li>Severe sub-zero winter freeze cycles freezing uninsulated water lines in exterior walls or unconditioned crawlspaces.</li>
        <li>Overburdened municipal storm and combined sewer mains forcing wastewater backward into lower-level fixtures.</li>
        <li>Aging plumbing supply fixtures, failing mechanical pressure relief valves, or corroded supply connectors.</li>
      </ul>

      <h2>Professional Protocol vs. DIY Risks</h2>
      <p>
        While minor surface spills can be dried with household towels, deep moisture intrusion behind drywall, beneath subfloors, and within insulation cavities requires industrial-grade extraction and dehumidification. Leaving moisture untreated often results in visible fungal colonies within 48 hours.
      </p>
      <p>
        Independent contractors utilize thermal imaging cameras and commercial desiccant dehumidifiers to verify complete structural drying across all building cavities.
      </p>

      {subservice.priority && (
        <div>
          <h2>Local Municipal Hubs for {subservice.name}</h2>
          <p class="text-sm text-slate-600 mb-4">
            Explore local city guidelines, municipal utility contacts, and emergency contractor routing:
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 my-4 not-prose">
            {citiesData.map((c) => (
              <a
                href={`/${c.slug}-mi/${service.slug}/${subservice.slug}/`}
                class="p-3 text-center rounded-lg border border-slate-200 bg-white hover:border-amber-500 hover:shadow-sm text-xs font-semibold text-slate-800 hover:text-amber-600 transition-all"
              >
                {c.name} {subservice.name} →
              </a>
            ))}
          </div>
        </div>
      )}

      <h2>Related Services in This Category</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-6 not-prose">
        {siblingSubs.map((sib) => (
          <a
            href={`/${service.slug}/${sib.slug}/`}
            class="p-4 rounded-xl border border-slate-200 bg-white hover:border-amber-500 hover:shadow-sm text-sm font-semibold text-slate-800 hover:text-amber-600 transition-all"
          >
            {sib.name} →
          </a>
        ))}
      </div>
    </>
  )}
</ServicePage>
