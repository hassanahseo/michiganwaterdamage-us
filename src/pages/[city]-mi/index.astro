---
import CityPage from '../../layouts/CityPage.astro';
import citiesData from '../../data/cities.json';
import servicesData from '../../data/services.json';
import subservicesData from '../../data/subservices.json';
import faqsData from '../../data/faqs.json';

export async function getStaticPaths() {
  return citiesData.map((city) => {
    const prioritySubs = subservicesData.filter((s) => s.priority);
    return {
      params: { city: city.slug },
      props: { city, services: servicesData, prioritySubs, faqs: faqsData },
    };
  });
}

const { city, services, prioritySubs, faqs } = Astro.props;

// Dynamically load MDX content if available
const mdxModules = import.meta.glob('/src/content/cities/*.mdx', { eager: true }) as Record<string, any>;
const mdxPath = `/src/content/cities/${city.slug}.mdx`;
const BodyContent = mdxModules[mdxPath]?.default;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: `${city.name}, MI`, url: `/${city.slug}-mi/` },
];
---

<CityPage
  title={`Water Damage & Plumbing Referral in ${city.name}, MI | 24/7 Line`}
  metaDescription={`24/7 referral network connecting ${city.name}, Michigan homeowners with independent emergency water damage, mold, sewage, and plumbing specialists.`}
  h1={`Emergency Property Damage & Plumbing Referral in ${city.name}, MI`}
  citySlug={city.slug}
  cityName={city.name}
  service="water-damage"
  serviceName="property damage specialist"
  breadcrumbs={breadcrumbs}
  faqs={faqs.slice(0, 4)}
  pageType="city-hub"
  showFaqComponent={!BodyContent}
  showNeighborhoodGrid={!BodyContent}
  showServiceGrid={!BodyContent}
  showCityGrid={!BodyContent}
  showLandlordBlock={!BodyContent}
>
  {BodyContent ? (
    <BodyContent />
  ) : (
    <>
      <h2>Direct Answer & Local 24/7 Referral Service</h2>
      <p>
        Michigan Water Damage Referral Network provides immediate 24/7 telephone connections to independent, licensed restoration and plumbing contractors serving {city.name} and {city.county.value}.
      </p>
      <p>
        Whether you are managing sudden basement flooding, a burst frozen water pipe, sewer line backup, or suspected mold growth, our routing line connects you directly to an independent local specialist.
      </p>

      <h2>Local Municipal Profile & Housing Characteristics</h2>
      <p>
        Residential properties in {city.name} possess distinct architectural and infrastructure characteristics:
      </p>
      <ul>
        <li>
          <strong>Housing Age & Foundation:</strong> {city.housing_age.value}
        </li>
        <li>
          <strong>Water Utility & Sourcing:</strong> Potable water distribution and billing are managed by {city.water_utility.value}.
        </li>
        <li>
          <strong>Municipal Sewer Architecture:</strong> Wastewater and surface stormwater are conveyed through {city.sewer_system.value}.
        </li>
        <li>
          <strong>Local Building & Safety Office:</strong> Structural and plumbing permits are administered through the {city.permit_office.value}.
        </li>
      </ul>

      <h2>Historical Flood Vulnerability & Seasonal Climate Risks</h2>
      <p>
        {city.name} is susceptible to distinct seasonal meteorological risks that place substantial stress on residential basements, foundations, and plumbing infrastructure:
      </p>
      <ul>
        {city.flood_events.map((event) => (
          <li>
            <strong>Documented Flood Hazard:</strong> {event.value}
          </li>
        ))}
        {city.climate_risks.map((risk) => (
          <li>
            <strong>Seasonal Risk Factors:</strong> {risk.value}
          </li>
        ))}
      </ul>

      <h2>Local Restoration Perspectives for {city.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6 not-prose">
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-sm font-bold text-slate-900 mb-1">Water Damage Angle</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{city.local_angles['water-damage']}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-sm font-bold text-slate-900 mb-1">Mold Remediation Angle</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{city.local_angles['mold-remediation']}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-sm font-bold text-slate-900 mb-1">Biohazard & Sewage Angle</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{city.local_angles['biohazard-cleanup']}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <h3 class="text-sm font-bold text-slate-900 mb-1">Plumbing & Leaks Angle</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{city.local_angles['plumbing']}</p>
        </div>
      </div>

      <h2>Priority Emergency Sub-Services in {city.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 my-6 not-prose">
        {prioritySubs.map((sub) => (
          <a
            href={`/${city.slug}-mi/${sub.service}/${sub.slug}/`}
            class="p-3 rounded-lg border border-slate-200 bg-white hover:border-amber-500 hover:shadow-sm text-xs font-semibold text-slate-800 hover:text-amber-600 transition-all"
          >
            {sub.name} in {city.name} →
          </a>
        ))}
      </div>
    </>
  )}
</CityPage>
