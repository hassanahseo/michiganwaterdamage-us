---
import Base from './Base.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/Breadcrumbs.astro';
import CallButton from '../components/CallButton.astro';
import CityGrid from '../components/CityGrid.astro';
import Faq from '../components/Faq.astro';
import LastReviewed from '../components/LastReviewed.astro';
import JsonLd from '../components/JsonLd.astro';
import costsData from '../data/costs.json';
import problemGuides from '../data/guides.json';

interface Props {
  title: string;
  metaDescription: string;
  h1: string;
  service: string;
  serviceName: string;
  breadcrumbs: BreadcrumbItem[];
  faqs?: Array<{ question: string; answer: string }>;
  city?: string;
  pageType?: string;
  showFaqComponent?: boolean;
  showCityGridComponent?: boolean;
}

const {
  title,
  metaDescription,
  h1,
  service,
  serviceName,
  breadcrumbs,
  faqs = [],
  city,
  pageType = 'service-pillar',
  showFaqComponent = true,
  showCityGridComponent = true,
} = Astro.props;

// Map exact matching cost guides
const costTopicMap: Record<string, string[]> = {
  'water-damage': ['water-damage-restoration-michigan'],
  'mold-remediation': ['mold-remediation-michigan'],
  'fire-damage': ['fire-damage-restoration-michigan'],
  'biohazard-cleanup': ['sewage-cleanup-michigan'],
  'plumbing': ['leak-detection-michigan', 'sump-pump-repair-replacement-michigan'],
};

const targetTopics = costTopicMap[service] || ['water-damage-restoration-michigan'];
const relevantCosts = costsData.filter((c) => targetTopics.includes(c.topic));

// Map relevant problem guides
const relevantGuides = problemGuides.filter((g) => {
  if (service === 'plumbing') return g.service === 'plumbing';
  if (service === 'water-damage') return ['basement-flooded-what-to-do', 'ceiling-dripping-wet-spot-upstairs', 'landlord-tenant-water-damage-mold'].includes(g.topic);
  if (service === 'mold-remediation') return ['mold-home-inspection-closing-michigan', 'landlord-tenant-water-damage-mold'].includes(g.topic);
  return g.service === service;
});
---

<Base
  title={title}
  description={metaDescription}
  service={service}
  serviceName={serviceName}
  city={city}
  pageType={pageType}
>
  <JsonLd
    type="service"
    title={title}
    description={metaDescription}
    areaServed={city ? `${city}, MI` : 'Michigan'}
    faqs={faqs}
  />

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="my-6">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        {h1}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        {metaDescription}
      </p>

      <div class="mt-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <CallButton service={service} serviceName={serviceName} />
      </div>
    </header>

    <div class="prose prose-slate max-w-none my-8 leading-relaxed">
      <slot />
    </div>

    <!-- Related Pricing Resources & Guides -->
    <section class="my-10 border-t border-slate-200 pt-8" aria-label="Related Pricing & Problem Guides">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Michigan Cost & Emergency Guides for {serviceName}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {relevantCosts.map((c) => (
          <a
            href={`/cost/${c.topic}/`}
            class="p-4 rounded-xl border border-slate-200 bg-white hover:border-amber-500 hover:shadow-sm"
          >
            <span class="text-xs font-semibold text-amber-700 uppercase">Cost Guide</span>
            <h3 class="text-sm font-bold text-slate-900 mt-1">{c.name}</h3>
            <p class="text-xs text-slate-500 mt-1">Typical: ${c.low.toLocaleString()} - ${c.high.toLocaleString()} {c.unit} →</p>
          </a>
        ))}
        {relevantGuides.map((g) => (
          <a
            href={`/guides/${g.topic}/`}
            class="p-4 rounded-xl border border-slate-200 bg-white hover:border-amber-500 hover:shadow-sm"
          >
            <span class="text-xs font-semibold text-sky-700 uppercase">Problem Guide</span>
            <h3 class="text-sm font-bold text-slate-900 mt-1">{g.title}</h3>
            <p class="text-xs text-slate-500 mt-1">Step-by-step diagnostic actions →</p>
          </a>
        ))}
      </div>
    </section>

    {showFaqComponent && faqs.length > 0 && <Faq items={faqs} />}

    {showCityGridComponent && <CityGrid serviceSlug={service} title={`Local ${serviceName} Coverage Across Michigan`} />}

    <LastReviewed />
  </div>
</Base>
