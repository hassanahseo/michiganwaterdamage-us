---
import servicesData from '../data/services.json';
import citiesData from '../data/cities.json';
import costsData from '../data/costs.json';
import problemGuides from '../data/guides.json';
import Disclosure from './Disclosure.astro';
---

<footer class="mt-20 border-t border-slate-200 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand & Referral Notice -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="flex flex-col">
          <span class="text-xl font-black tracking-tight text-white">
            Michigan Water Damage
          </span>
          <span class="text-xs font-semibold tracking-wider uppercase text-amber-400">
            Referral Network
          </span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          Statewide Michigan emergency referral service connecting property owners 24/7 with independent damage restoration and plumbing specialists.
        </p>
        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <p><a href="/how-it-works/" class="hover:text-amber-400 transition-colors">How It Works</a></p>
          <p><a href="/disclosure/" class="hover:text-amber-400 transition-colors">Referral Disclosure</a></p>
          <p><a href="/editorial-policy/" class="hover:text-amber-400 transition-colors">Editorial Policy</a></p>
          <p><a href="/privacy/" class="hover:text-amber-400 transition-colors">Privacy Policy</a></p>
          <p><a href="/terms/" class="hover:text-amber-400 transition-colors">Terms of Service</a></p>
          <p><a href="/contact/" class="hover:text-amber-400 transition-colors">Contact</a></p>
          <p><a href="/sitemap/" class="hover:text-amber-400 font-semibold text-amber-300">HTML Sitemap</a></p>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">Emergency Services</h3>
        <ul class="space-y-2 text-sm text-slate-400">
          {servicesData.map(service => (
            <li>
              <a href={`/${service.slug}/`} class="hover:text-amber-400 transition-colors">
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Michigan Cities Served -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">Michigan Hubs</h3>
        <ul class="space-y-2 text-sm text-slate-400">
          {citiesData.map(city => (
            <li>
              <a href={`/${city.slug}-mi/`} class="hover:text-amber-400 transition-colors">
                {city.name}, MI
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Cost & Emergency Guides -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">Pricing & Problem Guides</h3>
        <ul class="space-y-1.5 text-xs text-slate-400 mb-4">
          {costsData.map(c => (
            <li>
              <a href={`/cost/${c.topic}/`} class="hover:text-amber-400 transition-colors">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-2">Emergency Problem Guides</h4>
        <ul class="space-y-1.5 text-xs text-slate-400">
          {problemGuides.map(g => (
            <li>
              <a href={`/guides/${g.topic}/`} class="hover:text-amber-400 transition-colors">
                {g.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Mandatory Referral Disclosure Box -->
    <div class="border-t border-slate-800 pt-8 pb-4">
      <Disclosure variant="full" class="bg-slate-800/80 border-slate-700 text-slate-300" />
    </div>

    <!-- Copyright -->
    <div class="mt-8 border-t border-slate-800 pt-6 text-center text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Michigan Water Damage Referral Network. All rights reserved.</p>
    </div>
  </div>
</footer>
