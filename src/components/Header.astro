---
import servicesData from '../data/services.json';
import citiesData from '../data/cities.json';
import phonesData from '../data/phones.json';

interface Props {
  currentService?: string;
}

const { currentService = 'water-damage' } = Astro.props;
const phone = currentService === 'plumbing' ? phonesData.plumbing : phonesData.restoration;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur shadow-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="/" class="flex flex-col group">
      <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 group-hover:text-amber-600 transition-colors">
        Michigan Water Damage
      </span>
      <span class="text-[11px] font-semibold tracking-wider uppercase text-amber-700">
        Referral Network
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-700">
      <!-- Services Dropdown -->
      <div class="relative group py-2">
        <button class="flex items-center gap-1 hover:text-amber-600 transition-colors">
          <span>Services</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute left-0 mt-2 hidden w-64 rounded-xl border border-slate-200 bg-white p-3 shadow-xl group-hover:block transition-all">
          {servicesData.map(service => (
            <a
              href={`/${service.slug}/`}
              class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-800 hover:bg-slate-50 hover:text-amber-600"
            >
              {service.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Cities Dropdown -->
      <div class="relative group py-2">
        <button class="flex items-center gap-1 hover:text-amber-600 transition-colors">
          <span>Cities</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute left-0 mt-2 hidden w-56 rounded-xl border border-slate-200 bg-white p-3 shadow-xl group-hover:block transition-all">
          {citiesData.map(city => (
            <a
              href={`/${city.slug}-mi/`}
              class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-800 hover:bg-slate-50 hover:text-amber-600"
            >
              {city.name}
            </a>
          ))}
        </div>
      </div>

      <a href="/cost/water-damage-restoration-michigan/" class="hover:text-amber-600 transition-colors">
        Cost Guides
      </a>
      <a href="/how-it-works/" class="hover:text-amber-600 transition-colors">
        How It Works
      </a>
    </nav>

    <!-- Header CTA Call Button -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${phone.tel}`}
        class="hidden sm:flex items-center gap-2 rounded-xl bg-amber-600 px-4 py-2.5 text-sm font-bold text-white shadow hover:bg-amber-700 transition-all active:scale-95"
        data-ga-event="tel-click"
        data-phone-line={phone.display}
        data-service={currentService}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current shrink-0" viewBox="0 0 24 24">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1c-9.39 0-17-7.61-17-17a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.2 2.2z"/>
        </svg>
        <span>24/7 Call: {phone.display}</span>
      </a>

      <!-- Mobile Menu Toggle Button (vanilla HTML/JS) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden rounded-lg p-2 text-slate-700 hover:bg-slate-100 focus:outline-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden border-b border-slate-200 bg-white px-4 pb-4 pt-2 md:hidden">
    <div class="space-y-2 text-base font-semibold text-slate-800">
      <div class="py-1">
        <span class="block text-xs uppercase text-slate-400 font-bold px-2 py-1">Services</span>
        {servicesData.map(service => (
          <a href={`/${service.slug}/`} class="block rounded-lg px-2 py-1.5 hover:bg-slate-50 hover:text-amber-600">
            {service.name}
          </a>
        ))}
      </div>
      <div class="py-1 border-t border-slate-100">
        <span class="block text-xs uppercase text-slate-400 font-bold px-2 py-1">Cities</span>
        {citiesData.map(city => (
          <a href={`/${city.slug}-mi/`} class="block rounded-lg px-2 py-1.5 hover:bg-slate-50 hover:text-amber-600">
            {city.name}
          </a>
        ))}
      </div>
      <div class="py-1 border-t border-slate-100 space-y-1">
        <a href="/cost/water-damage-restoration-michigan/" class="block rounded-lg px-2 py-1.5 hover:bg-slate-50 hover:text-amber-600">
          Cost Guides
        </a>
        <a href="/how-it-works/" class="block rounded-lg px-2 py-1.5 hover:bg-slate-50 hover:text-amber-600">
          How It Works
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !isExpanded);
      menu.classList.toggle('hidden');
    });
  }
</script>
