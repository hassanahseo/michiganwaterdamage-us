---
import servicesData from '../data/services.json';
import { getPhone } from '../utils/phone';

interface Props {
  citySlug?: string;
  cityName?: string;
  currentService?: string;
  showPhone?: boolean;
}

const {
  citySlug,
  cityName,
  currentService,
  showPhone = false,
} = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
  {servicesData
    .filter(s => !currentService || s.slug !== currentService)
    .map(service => {
      const phone = getPhone(service.slug);
      const link = citySlug ? `/${citySlug}-mi/${service.slug}/` : `/${service.slug}/`;
      return (
        <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              <a href={link} class="hover:text-amber-600 transition-colors">
                {cityName ? `${service.name} in ${cityName}` : service.name}
              </a>
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              {service.description}
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <a href={link} class="text-sm font-semibold text-slate-900 hover:text-amber-600 flex items-center gap-1">
              View Guide
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            {showPhone && (
              <a href={`tel:${phone.tel}`} class="text-xs font-bold px-3 py-1.5 rounded-lg bg-amber-50 text-amber-800 hover:bg-amber-100 transition-colors">
                {phone.display}
              </a>
            )}
          </div>
        </div>
      );
    })}
</div>
